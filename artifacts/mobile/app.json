{
  "expo": {
    "name": "Site Snap",
    "slug": "workspace",
    "version": "1.0.0",
    "orientation": "default",
    "icon": "./assets/images/icon.png",
    "scheme": "sitesnap",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "splash": {
      "image": "./assets/images/sitesnap-logo.png",
      "resizeMode": "contain",
      "backgroundColor": "#172034"
    },
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.sitesnap.buildcore",
      "infoPlist": {
        "UIBackgroundModes": [
          "remote-notification"
        ],
        "NSMicrophoneUsageDescription": "Site Snap uses your microphone for voice commands so you can log hours, daily notes, and project updates hands-free.",
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "package": "com.sitesnap.buildcore",
      "permissions": [
        "android.permission.RECEIVE_BOOT_COMPLETED",
        "android.permission.VIBRATE",
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.ACCESS_FINE_LOCATION",
        "android.permission.RECORD_AUDIO",
        "android.permission.CAMERA",
        "android.permission.MODIFY_AUDIO_SETTINGS"
      ]
    },
    "web": {
      "favicon": "./assets/images/sitesnap-logo.png"
    },
    "plugins": [
      [
        "expo-router",
        {
          "origin": "https://sitesnapdemo.replit.app/"
        }
      ],
      "expo-font",
      "expo-web-browser",
      "expo-secure-store",
      [
        "expo-notifications",
        {
          "icon": "./assets/images/sitesnap-logo.png",
          "color": "#FF6600",
          "defaultChannel": "default"
        }
      ],
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "Site Snap uses your location to show current weather at your job site.",
          "locationAlwaysAndWhenInUsePermission": "Site Snap uses your location to show current weather at your job site."
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Site Snap uses your photo library to attach site photos to daily reports.",
          "cameraPermission": "Site Snap uses your camera to capture site photos for daily reports."
        }
      ],
      [
        "expo-camera",
        {
          "cameraPermission": "Site Snap uses your camera to record 3D site scan walkthroughs.",
          "microphonePermission": "Site Snap uses the microphone when recording site scan videos.",
          "recordAudioAndroid": true
        }
      ],
      "expo-audio"
    ],
    "extra": {
      "eas": {
        "projectId": "3b2289f1-27d6-4ab1-ba27-8321e7c4bc5f"
      }
    },
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    }
  }
}
